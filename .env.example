# Create a bot with Telegram's @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Optional but strongly recommended after you learn your chat ID.
# Multiple IDs may be comma-separated. Example: 123456789,-1001234567890
TELEGRAM_ALLOWED_CHAT_IDS=

# A relative path is created in the project folder.
DATABASE_PATH=btc_observer.sqlite3

# Save every usable Polymarket price observation to raw_ticks in SQLite.
STORE_RAW_TICKS=true

# Send Sweet Spot, Pullback, opposite-side $0.80+, and resolution alerts.
ALERTS_ENABLED=true
LOG_LEVEL=INFO

# Optional overrides if default public endpoints are unavailable in your region.
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
